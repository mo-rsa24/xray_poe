# large data & checkpoints — never commit these
# /data and /ckpts are machine-specific symlinks into /datasets/mmolefe on mscluster;
# trailing-slash patterns match dirs only, so list the bare names too to catch the symlinks
/data/
/data
data.zip
*.zip
ckpts/
/ckpts
ckpts_*/
logs/
figures/
runs/
/plans/
plans_v1_archive/
briefs/
paper/
# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
illuminate-output/
outputs/
# todoist/
*.so

# Jupyter
.ipynb_checkpoints/

# env / secrets — never commit
.env
*.env
kaggle.json
wandb/

# .claude — rsync to mscluster with the full snapshot, not tracked in git
.claude/

# OS
.DS_Store
Thumbs.db

# heavy outputs — rsync to mscluster separately, not tracked in git
# (41 small analysis files under results/ were tracked earlier; they stay tracked —
#  gitignore only stops the ~37k untracked result artifacts from flooding git)
results/
learning-captures/
